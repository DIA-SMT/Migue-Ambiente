# Config del bot. Copiar a .env y completar.
# El .env NUNCA va al repo (ver .gitignore) y vive solo en la VPS.

# --- obligatorio ---
BOT_TOKEN=

# --- modo de recepcion ---
# false = long polling (no necesita dominio ni puerto)
# true  = webhook (requiere PORT en bots.json + entrada en nginx)
USE_WEBHOOK=false

# --- logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- infra local de la VPS ---
# Redis ya queda instalado y escuchando solo en localhost
REDIS_URL=redis://127.0.0.1:6379

# Postgres: la URL con la password real la genera provision.sh en
# /srv/bots/.db-credentials — copiala de ahi
DATABASE_URL=
DB_POOL_MAX=5
