# ===========================================================================
# PANEL · variables de entorno
# ===========================================================================
# En desarrollo: copiar a panel/.env.local (ignorado por git).
# En la VPS:     /srv/bots/.secrets/panel.env  (permisos 600, dueño `bots`)
#
# TODO lo que lleva NEXT_PUBLIC_ queda embebido en el JavaScript que se sirve al
# navegador. Es público por definición.
#
# LA SERVICE_ROLE NO VA ACÁ. Ni con NEXT_PUBLIC_ ni sin él. Pasa por encima de
# RLS y da lectura y escritura sobre los datos de todos los vecinos; en un
# Next.js un import distraído la lleva al bundle. El panel no la necesita: usa
# la clave anónima más Supabase Auth, y RLS es lo que limita a cada persona.
# ===========================================================================

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Pública por diseño. Su seguridad depende ENTERAMENTE de que RLS esté bien.
# Para auditarlo:  select * from public.v_auditoria_rls where alerta is not null;
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bucket de Storage donde viven los documentos. Tiene que ser el MISMO que usa
# el worker, o el panel sube archivos donde el worker no los busca.
NEXT_PUBLIC_SUPABASE_BUCKET_DOCUMENTOS=documentos
