# ===========================================================================
# MIGUE AMBIENTE · variables de entorno
# ===========================================================================
# Este archivo es una PLANTILLA y sí se versiona. Nunca lleva valores reales.
#
# Hay DOS entornos separados y no comparten secretos. Mezclarlos es la forma
# más común de filtrar una clave, así que están en secciones distintas con una
# advertencia en el medio. Leé la advertencia.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1 · BOT Y WORKER  (corren en la VPS)
# ---------------------------------------------------------------------------
# Destino real:  /srv/bots/.secrets/migue.env   (permisos 600, dueño `bots`)
#
# Este archivo NO va al repositorio ni a Vercel. Lo leen los procesos
# `migue-bot` y `migue-worker` a través de PM2.
# ---------------------------------------------------------------------------

# --- Supabase (lado servidor) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# ⚠️  SERVICE_ROLE: pasa por encima de RLS. Da lectura y escritura sobre TODA
# la base, incluidos nombre, teléfono y dirección de vecinos.
# Sólo del lado servidor. NUNCA en el panel, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (respuestas del bot) ---
# https://openrouter.ai/keys
# Es el único costo variable del proyecto. Los modelos NO se configuran acá:
# se eligen desde el panel, en la tabla `configuracion`.
OPENROUTER_API_KEY=

# --- Telegram ---
# Se obtiene de @BotFather: /newbot y después /token
TELEGRAM_BOT_TOKEN=

# --- Infra local de la VPS ---
REDIS_URL=redis://127.0.0.1:6379
TZ=America/Argentina/Tucuman

# --- Storage de documentos (worker) ---
# Bucket de Supabase Storage donde el panel deja los PDF y DOCX.
# `documentos.ruta_storage` guarda la ruta DENTRO del bucket, sin el nombre del
# bucket adelante. El panel tiene que respetar esa convención al subir.
SUPABASE_BUCKET_DOCUMENTOS=documentos

# --- Opcionales ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Identifica al proceso en los logs y en pg_stat_activity
BOT_NAME=migue-bot


# ###########################################################################
# ⚠️  FRONTERA DE SEGURIDAD
#
# Todo lo de arriba se queda en el servidor.
# Todo lo de abajo llega al navegador de quien abra el panel.
#
# Cualquier variable con prefijo NEXT_PUBLIC_ queda embebida en el JavaScript
# que Vercel sirve al público. No es un riesgo teórico: en este mismo proyecto
# la clave anónima permitía leer nombre, teléfono y dirección de vecinos
# reales, porque RLS estaba abierto. La clave era pública por diseño; lo que
# faltaba era RLS.
#
# Regla: si una variable lleva NEXT_PUBLIC_, asumí que es de dominio público.
# ###########################################################################


# ---------------------------------------------------------------------------
# 2 · PANEL DE ADMINISTRACIÓN  (Next.js en Vercel)
# ---------------------------------------------------------------------------
# Destino real:
#   desarrollo → panel/.env.local        (ignorado por git)
#   producción → Variables de entorno del proyecto en Vercel
#
# El panel habla DIRECTO con Supabase. No usa la service_role: usa la clave
# anónima más Supabase Auth, y RLS es lo que limita a cada usuario a lo que
# el personal municipal puede ver.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Pública por diseño: va embebida en el bundle del navegador. Su seguridad
# depende ENTERAMENTE de que RLS esté bien configurado.
# Para auditarlo:  select * from public.v_auditoria_rls;
# Debe devolver cero filas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del panel, para los enlaces de Supabase Auth
NEXT_PUBLIC_URL_PANEL=https://tu-panel.vercel.app


# ===========================================================================
# CÓMO CARGAR LOS SECRETOS DE LA VPS SIN QUE QUEDEN EN NINGÚN HISTORIAL
# ===========================================================================
# `read -s` no muestra lo que escribís ni lo guarda en el historial del shell.
# El `HISTFILE=` del principio evita que la línea entera quede registrada.
#
#   HISTFILE= ; printf 'Token de Telegram: '; read -s T; echo
#   sed -i "s|^TELEGRAM_BOT_TOKEN=.*|TELEGRAM_BOT_TOKEN=$T|" /srv/bots/.secrets/migue.env
#   unset T
#
# Y para verificar que quedó cargada sin imprimir el valor:
#
#   grep -c '^TELEGRAM_BOT_TOKEN=.\+' /srv/bots/.secrets/migue.env   # debe dar 1
# ===========================================================================
